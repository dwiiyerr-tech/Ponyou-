+import fs from "fs";
+import os from "os";
+import path from "path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { StrategyGate, STRATEGY_GATE_LAYERS } from "../strategy-gate.js";
+
+let tempDir;
+
+beforeEach(() => {
+  tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "ponyou-strategy-gate-"));
+});
+
+afterEach(() => {
+  fs.rmSync(tempDir, { recursive: true, force: true });
+});
+
+function gate(overrides = {}) {
+  return new StrategyGate({
+    minWinRate: 0.80,
+    minBacktestTrades: 5,
+    minPaperTrades: 5,
+    minLiveTrades: 5,
+    ...overrides,
+  });
+}
+
+function trades({ wins, losses, strategyId = "strat-id" }) {
+  return [
+    ...Array.from({ length: wins }, () => ({ strategyId, pnl_pct: 18 })),
+    ...Array.from({ length: losses }, () => ({ strategyId, pnl_pct: -9 })),
+  ];
+}
+
+describe("StrategyGate", () => {
+  it("passes only when backtest, paper, and live evidence all satisfy thresholds", async () => {
+    const strategyGate = gate({
+      backtestRunner: async () => ({ winRate: 0.85, trades: 10, profitFactor: 1.5 }),
+      paperTradeReader: async () => ({ winRate: 0.82, trades: 8 }),
+      liveTradeReader: async () => ({ winRate: 0.88, trades: 7 }),
+    });
+
+    const result = await strategyGate.evaluate("strat-id");
+
+    expect(result).toMatchObject({
+      passed: true,
+      failedLayer: null,
+      rejectReason: null,
+      scores: {
+        backtest: 0.85,
+        paper: 0.82,
+        live: 0.88,
+      },
+    });
+    expect(result.evidence.backtest.profitFactor).toBe(1.5);
+  });
+
+  it("fails at layer 1 and does not read later evidence when backtest quality is weak", async () => {
+    const paperTradeReader = vi.fn(async () => ({ winRate: 0.90, trades: 8 }));
+    const liveTradeReader = vi.fn(async () => ({ winRate: 0.90, trades: 8 }));
+    const strategyGate = gate({
+      backtestRunner: async () => ({ winRate: 0.65, trades: 10, profitFactor: 1.8 }),
+      paperTradeReader,
+      liveTradeReader,
+    });
+
+    const result = await strategyGate.evaluate("strat-id");
+
+    expect(result.passed).toBe(false);
+    expect(result.failedLayer).toBe(STRATEGY_GATE_LAYERS.BACKTEST);
+    expect(result.rejectReason).toMatch("backtest win rate");
+    expect(paperTradeReader).not.toHaveBeenCalled();
+    expect(liveTradeReader).not.toHaveBeenCalled();
+  });
+
+  it("fails at layer 1 when backtest profit factor is not above 1", async () => {
+    const strategyGate = gate({
+      backtestRunner: async () => ({ winRate: 0.90, trades: 10, profitFactor: 1.0 }),
+      paperTradeReader: async () => ({ winRate: 0.90, trades: 8 }),
+      liveTradeReader: async () => ({ winRate: 0.90, trades: 8 }),
+    });
+
+    const result = await strategyGate.evaluate("strat-id");
+
+    expect(result.passed).toBe(false);
+    expect(result.failedLayer).toBe(STRATEGY_GATE_LAYERS.BACKTEST);
+    expect(result.rejectReason).toMatch("profit factor");
+  });
+
+  it("fails at layer 2 when paper evidence is below the required win rate", async () => {
+    const strategyGate = gate({
+      backtestRunner: async () => ({ winRate: 0.90, trades: 10, profitFactor: 1.8 }),
+      paperTradeReader: async () => ({ winRate: 0.60, trades: 8 }),
+      liveTradeReader: async () => ({ winRate: 0.90, trades: 8 }),
+    });
+
+    const result = await strategyGate.evaluate("strat-id");
+
+    expect(result.passed).toBe(false);
+    expect(result.failedLayer).toBe(STRATEGY_GATE_LAYERS.PAPER);
+    expect(result.rejectReason).toMatch("paper win rate");
+  });
+
+  it("fails at layer 3 when live trade count is below the minimum", async () => {
+    const strategyGate = gate({
+      minLiveTrades: 20,
+      backtestRunner: async () => ({ winRate: 0.90, trades: 10, profitFactor: 2.0 }),
+      paperTradeReader: async () => ({ winRate: 0.85, trades: 8 }),
+      liveTradeReader: async () => ({ winRate: 0.90, trades: 5 }),
+    });
+
+    const result = await strategyGate.evaluate("strat-id");
+
+    expect(result.passed).toBe(false);
+    expect(result.failedLayer).toBe(STRATEGY_GATE_LAYERS.LIVE);
+    expect(result.rejectReason).toMatch("live trades");
+  });
+
+  it("reads matching live evidence from a local attribution file by strategy id", async () => {
+    const attributionPath = path.join(tempDir, "trade-attribution.json");
+    fs.writeFileSync(
+      attributionPath,
+      JSON.stringify({
+        trades: [
+          ...trades({ wins: 4, losses: 1, strategyId: "strat-id" }),
+          ...trades({ wins: 0, losses: 5, strategyId: "other-strat" }),
+        ],
+      })
+    );
+    const strategyGate = gate({
+      attributionPath,
+      backtestRunner: async () => ({ winRate: 0.90, trades: 10, profitFactor: 2.0 }),
+      paperTradeReader: async () => ({ winRate: 0.85, trades: 8 }),
+      convictionReader: () => null,
+    });
+
+    const result = await strategyGate.evaluate("strat-id");
+
+    expect(result.passed).toBe(true);
+    expect(result.scores.live).toBe(0.8);
+    expect(result.evidence.live.trades).toBe(5);
+  });
+
+  it("can evaluate candidate-provided evidence snapshots without readers", async () => {
+    const strategyGate = gate();
+
+    const result = await strategyGate.evaluate({
+      id: "snapshot-strat",
+      evidence: {
+        backtest: { winRate: 0.92, trades: 12, profitFactor: 2.1 },
+        paper: { winRate: 0.83, trades: 6 },
+        live: { winRate: 0.84, trades: 6 },
+      },
+    });
+
+    expect(result.passed).toBe(true);
+    expect(result.scores).toEqual({ backtest: 0.92, paper: 0.83, live: 0.84 });
+  });
+});

