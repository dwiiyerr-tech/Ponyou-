# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://pump.helius-rpc.com

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (default)
OPENROUTER_API_KEY=

# Option B: LM Studio (local)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=dummy-helius-key
GMGN_ROUTE_KEY=dummy-gmgn-key

# ── Telegram Notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Vault / Tabungan ──────────────────────────────────────────────────────────
VAULT_WALLET=

# ── Misc ──────────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=info