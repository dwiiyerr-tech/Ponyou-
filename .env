# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://pump.helius-rpc.com

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (default)
OPENROUTER_API_KEY=

# Option B: LM Studio (local)
LLM_BASE_URL=http://localhost:8787/v1
LLM_API_KEY=local-proxy-key
LLM_MODEL=local-claude-proxy

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=dummy-helius-key
# GMGN_ROUTE_KEY deprecated — migrated to Jupiter + DexScreener
BIRDEYE_API_KEY=

# ── Telegram Notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Vault / Tabungan ──────────────────────────────────────────────────────────
VAULT_WALLET=

# ── Misc ──────────────────────────────────────────────────────────────────────
DRY_RUN=true
LOG_LEVEL=info