# ═══════════════════════════════════════════════════════════════════════════
# PONYOU ENVIRONMENT VARIABLES
# Copy ke .env dan isi dengan nilai Anda
# ═══════════════════════════════════════════════════════════════════════════

# ─── WALLET & RPC ─────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your-private-key-here
RPC_URL=https://pump.helius-rpc.com

# ─── LLM PROVIDER CONFIGURATION ────────────────────────────────────────────

# 1. OPENROUTER (Default) - Supports Claude, GPT, Mistral, etc.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1

# 2. OpenAI - GPT-4, GPT-3.5
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1

# 3. Anthropic - Claude API
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# 4. Groq - Free & Fast
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxxx
# LLM_BASE_URL=https://api.groq.com/openai/v1

# 5. Mistral AI
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=xxxxxxxxxxxxx
# LLM_BASE_URL=https://api.mistral.ai/v1

# 6. Together AI
# LLM_PROVIDER=together
# TOGETHER_API_KEY=xxxxxxxxxxxxx
# LLM_BASE_URL=https://api.together.xyz/v1

# 7. LM Studio (Local)
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1

# 8. Ollama (Local)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1

# 9. Custom OpenAI-Compatible
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-api.com/v1
# LLM_API_KEY=xxxxxxxxxxxxx

# ─── EXTERNAL APIs ────────────────────────────────────────────────────────
HELIUS_API_KEY=xxx
GMGN_ROUTE_KEY=xxx
JUPITER_API_KEY=xxx
PUBLIC_API_KEY=xxx

# ─── TELEGRAM (Optional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_CHAT_ID=xxx

# ─── VAULT WALLET (Optional) ──────────────────────────────────────────────
VAULT_WALLET=xxx

# ─── AGENT MERIDIAN (Optional) ────────────────────────────────────────────
AGENT_MERIDIAN_API_URL=https://api.agentmeridian.xyz/api

# ─── DEBUG ────────────────────────────────────────────────────────────────
DRY_RUN=true
LOG_LEVEL=info
DEBUG=false
