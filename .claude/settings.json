{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "LS",
      "TodoWrite",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npx vitest:*)",
      "Bash(npx vitest run:*)",
      "Bash(pytest:*)",
      "Bash(node --version:*)",
      "Bash(node -e:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/seed.txt)",
      "Read(**/mnemonic*)",
      "Read(**/private_key*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(secrets/**)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(npm publish:*)",
      "Bash(npx publish:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)"
    ]
  }
}
