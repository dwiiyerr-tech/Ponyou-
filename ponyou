#!/usr/bin/env node
/**
 * ponyou — global CLI entry point
 * Ketik: ponyou          → tampil menu
 *        ponyou ui        → TUI launcher
 *        ponyou start     → live trading
 *        ponyou dev       → demo interaktif
 *        ponyou dry       → alias demo one-shot
 *        ponyou demo      → demo one-shot
 *        ponyou dashboard → dashboard real-time
 *        ponyou setup     → setup wizard
 *        ponyou status    → status cepat
 */

import fs from "fs";
import { spawn } from "child_process";
import path from "path";
import { fileURLToPath } from "url";

const DIR = path.dirname(fileURLToPath(import.meta.url));
const arg = process.argv[2]?.toLowerCase();

const COMMANDS = [
  { cmd: "ui",        desc: "TUI launcher — menu interaktif penuh",    npm: "ui" },
  { cmd: "dashboard", desc: "Dashboard real-time",                      npm: "dashboard" },
  { cmd: "dry",       desc: "Demo one-shot (test semua siklus)",        npm: "dry" },
  { cmd: "demo",      desc: "Demo one-shot (alias dry)",                npm: "demo" },
  { cmd: "dev",       desc: "Agent interaktif (EXECUTION_MODE=demo)",   npm: "dev" },
  { cmd: "start",     desc: "Agent live (transaksi nyata)",             npm: "start" },
  { cmd: "setup",     desc: "Setup wizard (konfigurasi awal)",          npm: "setup" },
  { cmd: "status",    desc: "Cek status cepat tanpa menjalankan agent", npm: null },
];

const R = "\x1b[0m";
const B = "\x1b[1m";
const C = "\x1b[36m";
const G = "\x1b[32m";
const Y = "\x1b[33m";
const D = "\x1b[2m";

function printMenu() {
  console.log(`\n${C}${B}🐎 Ponyou AI Trading Agent${R}\n`);
  console.log(`${D}Usage: ponyou <command>${R}\n`);
  const pad = Math.max(...COMMANDS.map(c => c.cmd.length));
  for (const c of COMMANDS) {
    const label = `ponyou ${c.cmd}`.padEnd(pad + 9);
    console.log(`  ${G}${label}${R}  ${D}${c.desc}${R}`);
  }
  console.log(`\n${D}Contoh: ponyou ui | ponyou demo | ponyou dev${R}\n`);
}

function runNpm(script) {
  const proc = spawn("npm", ["run", script], {
    cwd: DIR, stdio: "inherit", shell: true,
  });
  proc.on("close", code => process.exit(code ?? 0));
}

function readJson(file) {
  try { return JSON.parse(fs.readFileSync(path.join(DIR, file), "utf8")); }
  catch { return {}; }
}

function readEnv() {
  try {
    const lines = fs.readFileSync(path.join(DIR, ".env"), "utf8").split("\n");
    const env = {};
    for (const line of lines) {
      if (line.startsWith("#") || !line.includes("=")) continue;
      const [k, ...v] = line.split("=");
      env[k.trim()] = v.join("=").trim();
    }
    return env;
  } catch { return {}; }
}

function showStatus() {
  const state = readJson("state.json");
  const plan  = readJson("trading-plan.json");
  const intel = readJson("market-intel.json");
  const env   = readEnv();

  const positions = Object.values(state.positions || {}).filter(p => !p.closed);
  const hasWallet = !!env.WALLET_PRIVATE_KEY;
  const hasLlm    = !!(env.OPENROUTER_API_KEY || (env.LLM_BASE_URL && env.LLM_API_KEY));
  const executionMode = (env.EXECUTION_MODE || (env.DRY_RUN === "true" ? "demo" : "live")).toLowerCase();
  const demoMode = executionMode === "demo";

  console.log(`\n${C}${B}🐎 Ponyou Status${R}`);
  console.log(`  Mode     : ${demoMode ? Y + "DEMO (aman)" : G + "LIVE (transaksi nyata)"}${R}`);
  console.log(`  Market   : ${B}${intel.currentCondition || "NORMAL"}${R}`);
  console.log(`  Plan     : Day ${plan.day || 1}/${plan.days_total || 30} | P&L: ${plan.today_pnl_pct ?? 0}%`);
  console.log(`  Posisi   : ${positions.length} terbuka`);
  console.log(`  Wallet   : ${hasWallet ? G + "✓ configured" : Y + "⚠ belum diset"}${R}`);
  console.log(`  LLM      : ${hasLlm    ? G + "✓ configured" : Y + "⚠ belum diset"}${R}\n`);
}

// ── Route ─────────────────────────────────────────────────
if (!arg) { printMenu(); process.exit(0); }

if (arg === "status") { showStatus(); process.exit(0); }

const found = COMMANDS.find(c => c.cmd === arg);
if (!found) {
  console.log(`\n${Y}Perintah tidak dikenal: "${arg}"${R}`);
  printMenu();
  process.exit(1);
}

runNpm(found.npm);
