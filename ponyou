#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
cd "${ROOT_DIR}"

cmd="${1:-agent}"
sub="${2:-}"

print_help() {
  cat <<'HELP'
Ponyou agent command surface

Usage:
  ponyou             Start live agent
  ponyou agent       Start live agent
  ponyou demo        Start demo agent
  ponyou status      Quick status snapshot
  ponyou agent24     Start 24x7 live agent supervisor
  ponyou doctor      Run demo readiness checks
  ponyou doctor live Run live readiness checks
  ponyou help        Show this help
HELP
}

show_status() {
  node --input-type=module <<'NODE'
import fs from "fs";

function readJson(file, fallback) {
  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch { return fallback; }
}

const config = readJson("user-config.json", {});
const state = readJson("state.json", { positions: {} });
const perf = readJson("performance.json", { trades: [] });
const positions = Object.keys(state.positions || {}).length;
const trades = perf.trades || [];
const wins = trades.filter((t) => t.win).length;
const winRate = trades.length ? ((wins / trades.length) * 100).toFixed(1) : "0.0";
const mode = config.executionMode || process.env.EXECUTION_MODE || "live";
const provider = config.llmProvider || process.env.LLM_PROVIDER || (process.env.LLM_BASE_URL ? "local" : "openrouter");
const strategy = config.strategy || config.activeStrategy || "scalping";
console.log("PONYOU STATUS");
console.log("Mode: " + String(mode).toUpperCase());
console.log("Strategy: " + strategy);
console.log("Open Positions: " + positions);
console.log("LLM Provider: " + provider);
console.log("Configured Capital: $" + (config.pilotCapitalUsd || "?"));
console.log("Trades: " + trades.length + " | Win Rate: " + winRate + "%");
NODE
}

case "${cmd}" in
  agent|start|live)
    exec npm start
    ;;
  status)
    show_status
    ;;
  demo)
    exec npm run dev
    ;;
  agent24)
    exec npm run agent:24x7
    ;;
  doctor)
    if [ "${sub}" = "live" ]; then
      exec npm run readiness:live
    fi
    exec npm run readiness
    ;;
  help|--help|-h)
    print_help
    ;;
  *)
    printf "Unknown command: %s\n\n" "${cmd}" >&2
    print_help >&2
    exit 1
    ;;
esac
