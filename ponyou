#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
cd "${ROOT_DIR}"

cmd="${1:-wizard}"
sub="${2:-}"

AGENT_SVC="ponyou-agent"
WORK_SVC="ponyou-autowork"

_svc_status() {
  local svc="$1"
  local state
  state=$(systemctl is-active "$svc" 2>/dev/null || echo "unknown")
  case "$state" in
    active)   printf "\e[32m● %s: running\e[0m\n" "$svc" ;;
    inactive) printf "\e[31m○ %s: stopped\e[0m\n" "$svc" ;;
    *)        printf "\e[33m? %s: %s\e[0m\n" "$svc" "$state" ;;
  esac
}

_header() {
  clear
  printf "\e[1;36m╔══════════════════════════════╗\n"
  printf "║      PONYOU CONTROL          ║\n"
  printf "╚══════════════════════════════╝\e[0m\n"
  _svc_status "$AGENT_SVC"
  _svc_status "$WORK_SVC"
  printf "\n"
}

wizard() {
  _header
  PS3=$'\nPilih opsi: '
  local options=(
    "Status bot"
    "Start bot (demo)"
    "Start bot (live)"
    "Stop bot"
    "Restart bot"
    "Live log bot"
    "──────────────"
    "Start autowork"
    "Stop autowork"
    "──────────────"
    "Buka dashboard"
    "Quick status"
    "Readiness check"
    "──────────────"
    "Keluar"
  )
  select opt in "${options[@]}"; do
    case "$opt" in
      "Status bot")
        systemctl status "$AGENT_SVC" --no-pager | head -20 ;;
      "Start bot (demo)")
        sudo systemctl start "$AGENT_SVC" && echo "Bot (demo) started." ;;
      "Start bot (live)")
        read -rp "⚠ Live mode pakai uang nyata. Yakin? (y/N): " c
        [[ "$c" =~ ^[Yy]$ ]] && exec npm start || echo "Dibatalkan." ;;
      "Stop bot")
        read -rp "Yakin stop? (y/N): " c
        [[ "$c" =~ ^[Yy]$ ]] && sudo systemctl stop "$AGENT_SVC" && echo "Stopped." || echo "Dibatalkan." ;;
      "Restart bot")
        sudo systemctl restart "$AGENT_SVC" && echo "Restarted." ;;
      "Live log bot")
        echo "Ctrl+C untuk keluar dari log."
        journalctl -u "$AGENT_SVC" -f --no-pager ;;
      "Start autowork")
        sudo systemctl start "$WORK_SVC" && echo "Autowork started." ;;
      "Stop autowork")
        sudo systemctl stop "$WORK_SVC" && echo "Autowork stopped." ;;
      "Buka dashboard")
        node "${ROOT_DIR}/dashboard.js" --port 3000 &
        sleep 1; echo "Dashboard: http://localhost:3000" ;;
      "Quick status")
        show_status ;;
      "Readiness check")
        npm run readiness ;;
      "──────────────") ;;
      "Keluar")
        echo "Bye."; exit 0 ;;
      *) echo "Pilihan tidak valid." ;;
    esac
    printf "\n"
    _header
  done
}

print_help() {
  cat <<'HELP'
Ponyou agent command surface

Usage:
  ponyou             Open chat mode (default)
  ponyou web         Start web dashboard and setup tutorial
  ponyou chat        Open chat mode (explicit)
  ponyou monitor     Open live dashboard
  ponyou wizard      Open setup wizard
  ponyou agent       Start live agent
  ponyou demo        Start demo agent
  ponyou status      Quick status snapshot
  ponyou agent24     Start 24x7 live agent supervisor
  ponyou doctor      Run demo readiness checks
  ponyou doctor live Run live readiness checks
  ponyou help        Show this help
HELP
}

show_status() {
  node --input-type=module <<'NODE'
import fs from "fs";

function readJson(file, fallback) {
  try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch { return fallback; }
}

const config = readJson("user-config.json", {});
const state = readJson("state.json", { positions: {} });
const perf = readJson("performance.json", { trades: [] });
const positions = Object.keys(state.positions || {}).length;
const trades = perf.trades || [];
const wins = trades.filter((t) => t.win).length;
const winRate = trades.length ? ((wins / trades.length) * 100).toFixed(1) : "0.0";
const mode = config.executionMode || process.env.EXECUTION_MODE || "live";
const provider = config.llmProvider || process.env.LLM_PROVIDER || (process.env.LLM_BASE_URL ? "local" : "openrouter");
const strategy = config.strategy || config.activeStrategy || "scalping";
console.log("PONYOU STATUS");
console.log("Mode: " + String(mode).toUpperCase());
console.log("Strategy: " + strategy);
console.log("Open Positions: " + positions);
console.log("LLM Provider: " + provider);
console.log("Configured Capital: $" + (config.pilotCapitalUsd || "?"));
console.log("Trades: " + trades.length + " | Win Rate: " + winRate + "%");
NODE
}

case "${cmd}" in
  wizard|chat|monitor|dashboard|logs|"")
    exec node "${ROOT_DIR}/terminal-app/src/index.js" "$@"
    ;;
  web)
    echo "Memulai Web Dashboard..."
    echo "Silakan buka browser Anda di: http://localhost:3000"
    echo "Jika Anda belum melakukan setup, buka: http://localhost:3000/wizard.html"
    exec node "${ROOT_DIR}/dashboard.js" --port 3000
    ;;
  agent|start|live)
    exec npm start
    ;;
  status)
    show_status
    ;;
  demo)
    exec npm run dev
    ;;
  agent24)
    exec npm run agent:24x7
    ;;
  doctor)
    if [ "${sub}" = "live" ]; then
      exec npm run readiness:live
    fi
    exec npm run readiness
    ;;
  help|--help|-h)
    print_help
    ;;
  *)
    printf "Unknown command: %s\n\n" "${cmd}" >&2
    print_help >&2
    exit 1
    ;;
esac
