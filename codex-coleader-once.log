+        { address: "B", fundedBy: "seed", relationGroupId: "cluster-a", lastAction: "buy", pct: 2.2 },
+        { address: "C", fundedBy: "seed", relationGroupId: "cluster-a", lastAction: "buy", pct: 2.1 },
