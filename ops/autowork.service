[Unit]
Description=Ponyou AutoWork — Claude 24x7 PR worker
Documentation=file:///home/ubuntu/ponyou/ops/autowork-ctl.sh
After=network-online.target
Wants=network-online.target
# Restart after ponyou-agent if both run on same machine
After=ponyou-agent.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ponyou

# PATH must include claude binary location
Environment=PATH=/home/ubuntu/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production

# Main loop — handles limit/review/done states with built-in sleep
ExecStartPre=/bin/mkdir -p /home/ubuntu/ponyou/logs/autowork
ExecStart=/home/ubuntu/ponyou/run-autowork-loop.sh \
  --interval 120 \
  --limit-wait 1800 \
  --log /home/ubuntu/ponyou/logs/autowork/daemon.log

# Always restart so we survive Claude limit exits and errors
Restart=always
RestartSec=30

# Give Claude time to finish current turn on shutdown
KillSignal=SIGINT
TimeoutStopSec=60

# Log via systemd journal (view with: journalctl -u ponyou-autowork -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ponyou-autowork

[Install]
WantedBy=multi-user.target
