/*
 * Ponyou TUI — dark hacker aesthetic.
 * bg #0d0d0d, gold #FFD700 borders/headers, accents per spec.
 */

Screen {
    background: #0d0d0d;
    color: #cccccc;
}

Header {
    background: #0d0d0d;
    color: #FFD700;
    text-style: bold;
    height: 3;
    border-bottom: heavy #FFD700;
}

Footer {
    background: #0d0d0d;
    color: #FFD700;
}

#main {
    height: 1fr;
}

#left, #center, #right {
    border: round #FFD700;
    padding: 0 1;
    background: #0d0d0d;
}

#left {
    width: 28%;
    color: #cccccc;
}

#center {
    width: 1fr;
    color: #cccccc;
}

#right {
    width: 34%;
    color: #cccccc;
}

.panel-title {
    color: #FFD700;
    text-style: bold;
}

.section-title {
    color: #FFD700;
    text-style: bold underline;
    padding-top: 1;
}

.muted {
    color: #888888;
}

.ok { color: #00FF41; }
.warn { color: #FF8C00; }
.err { color: #FF3333; }
.api { color: #00FFFF; }
.tool { color: #FFD700; }
.sys { color: #cccccc; }
.thought { color: #888888; text-style: italic; }

DataTable {
    background: #0d0d0d;
}

DataTable > .datatable--header {
    background: #1a1a1a;
    color: #FFD700;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1a1a1a;
}

#log-panel {
    background: #0d0d0d;
    color: #cccccc;
    scrollbar-color: #FFD700 #0d0d0d;
}

#ticker {
    height: 1;
    background: #1a1a1a;
    color: #FFD700;
    text-style: bold;
    border-top: heavy #FFD700;
}

#status-bar {
    height: 1;
    background: #0d0d0d;
    color: #FFD700;
}

.metric-label {
    color: #888888;
}

.metric-value {
    color: #FFD700;
    text-style: bold;
}
