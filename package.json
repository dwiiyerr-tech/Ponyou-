{
  "name": "ponyou",
  "version": "1.0.0",
  "type": "module",
  "description": "AI Agent for automated memecoin trading on Solana",
  "main": "index.js",
  "scripts": {
    "start": "node --disable-warning=DEP0040 index.js",
    "dev": "EXECUTION_MODE=demo node --disable-warning=DEP0040 index.js",
    "dry": "EXECUTION_MODE=demo node dry-run.mjs",
    "demo": "EXECUTION_MODE=demo node dry-run.mjs",
    "readiness": "node readiness-cli.js",
    "readiness:live": "node readiness-cli.js --mode live",
    "test": "NODE_OPTIONS='--disable-warning=DEP0040' vitest run",
    "test:watch": "NODE_OPTIONS='--disable-warning=DEP0040' vitest",
    "collab:bootstrap": "node infra/agent-collab/bootstrap-task.js",
    "collab:upgrade": "node infra/agent-collab/collab-upgrade.js",
    "collab:status": "node infra/agent-collab/collab-status.js",
    "collab:handoffs": "node infra/agent-collab/collab-handoffs.js",
    "collab:next": "node infra/agent-collab/collab-next.js",
    "collab:dispatch": "node infra/agent-collab/collab-dispatch.js",
    "collab:start": "node infra/agent-collab/collab-start.js",
    "collab:triage": "node infra/agent-collab/collab-triage.js",
    "collab:submit": "node infra/agent-collab/collab-submit.js",
    "backtest": "node tools/backtest-cli.js",
    "promote-demo": "node scripts/promote-demo.js",
    "agent:24x7": "bash ./ops/run-24x7.sh live",
    "agent:24x7:demo": "bash ./ops/run-24x7.sh demo",
    "wizard": "node terminal-app/src/modes/wizard-standalone.js",
    "setup": "node terminal-app/src/modes/wizard-standalone.js",
    "telegram:auth": "node scripts/telegram-auth.js",
    "secondbrain:setup": "node scripts/setup-secondbrain.mjs",
    "secondbrain:status": "node -e \"import('./secondbrain-sync.js').then(m=>console.log(m.buildSyncStatus()))\"",
    "notebooklm:export": "node scripts/export-notebooklm.js",
    "notebooklm:watch": "node scripts/export-notebooklm.js --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solana/web3.js": "^1.95.0",
    "blessed": "^0.1.81",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^4.22.2",
    "ink": "^5.2.1",
    "ink-big-text": "^2.0.0",
    "ink-box": "^2.0.0",
    "ink-gradient": "^1.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "jsonrepair": "^3.13.3",
    "neural-trader": "^2.8.11",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0",
    "ruflo": "^3.7.0-alpha.69",
    "telegram": "^2.26.22",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  },
  "bin": {
    "ponyou": "./ponyou"
  }
}
