# vault-proposals runtime state
vault-proposals.json

# Rug circuit-breaker persisted lock state — runtime only
rug-circuit-breaker-state.json

# Per-user Claude Code permissions/config — must not be shared,
# can contain credentials.
.claude/settings.local.json

# Per-operator config + wallet secrets — track ONLY the template
# (user-config.example.json). These hold live API keys / private keys and
# leaked into history before this rule; rotate the Shyft key when convenient.
user-config.json
devnet-wallet.json

# Vendored third-party skill packages (installed via the skills CLI, pinned by
# skills-lock.json, reproducible). Includes execution-class skills (gmgn-swap/
# cooking) we keep manual-only — not vendored into core per CLAUDE.md.
.agents/
.claude/skills/

